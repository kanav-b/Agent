# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# Port the server listens on. Optional — defaults to 3000.
PORT=3000

# Supabase project settings -> Data API -> Project URL
SUPABASE_URL=

# Supabase project settings -> API Keys -> secret key (service_role).
# This key bypasses row level security. Server-side only.
# Never commit it, never log it, never send it to a browser.
SUPABASE_SECRET_KEY=

# Shared secret Vapi must send as the x-vapi-tool-secret header on every
# custom-tool request. Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in the Vapi tool's custom headers.
VAPI_TOOL_SECRET=

# --- Twilio (SMS) ---
# Console -> Account Info. The auth token is a credential: never commit, log,
# or expose it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# An SMS-capable Twilio number in E.164 format, e.g. +14155550123.
TWILIO_FROM_NUMBER=

# Fallback destination for shop alerts, in E.164 format. Not a caller's number.
# A shop can set its own businesses.notification_phone, which wins over this.
# Optional: with neither set, shop alerts report "not_configured".
SHOP_NOTIFICATION_NUMBER=

# Master switch for SMS. Off unless this is exactly "true".
# Having Twilio credentials set is NOT enough to start texting people.
# Anything other than "true" or "false" stops the server with a clear message.
SMS_ENABLED=false

# --- Vapi provisioning (only needed by `npm run assistant:sync`) ---
# The server and `npm run assistant:preview` both run fine without these.
#
# Dashboard -> Organization -> API Keys -> a PRIVATE key. This is a credential:
# never commit, log, or expose it.
VAPI_API_KEY=

# Ids of the three tools you already created in the Vapi dashboard. These are
# identifiers, not credentials. Open each tool and copy its id.
# A new assistant cannot be created without all three — better no receptionist
# than one that cannot quote or take a request.
VAPI_ESTIMATE_TOOL_ID=
VAPI_APPOINTMENT_REQUEST_TOOL_ID=
VAPI_CALLBACK_REQUEST_TOOL_ID=

# Used only when CREATING a new assistant; an update keeps whatever the
# assistant already has. Set these to match your existing assistant.
# Defaults: openai / gpt-4o
VAPI_MODEL_PROVIDER=
VAPI_MODEL=
